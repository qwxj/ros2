<?xml version="1.0"?>
<robot name="my_car">

  <!-- ============================================================
       全局材质（RViz2 用）
       ============================================================ -->
  <material name="blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
    <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

  <!-- ============================================================
       根坐标系：车体在地面上的投影点（无质量、无几何）
       Gazebo 会把 fixed 关节的子 link 合并进来，所以这个空 link 没问题
       ============================================================ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       底盘
       box 0.40(x) x 0.30(y) x 0.10(z)，质量 2.0 kg
       惯性张量（实心长方体）：
         Ixx = m(y²+z²)/12 = 2*(0.09+0.01)/12 = 0.0166667
         Iyy = m(x²+z²)/12 = 2*(0.16+0.01)/12 = 0.0283333
         Izz = m(x²+y²)/12 = 2*(0.16+0.09)/12 = 0.0416667
       ============================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.30 0.10"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.30 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.0166667" ixy="0" ixz="0"
               iyy="0.0283333" iyz="0"
               izz="0.0416667"/>
    </inertial>
  </link>

  <!-- ============================================================
       左轮
       圆柱 r=0.06，厚 0.03，质量 0.3 kg，转轴沿 Y
       圆柱轴沿 Y 时：
         Iyy（绕轴）  = m*r²/2        = 0.3*0.0036/2 = 0.00054
         Ixx = Izz     = m(3r²+L²)/12 = 0.3*(0.0108+0.0009)/12 = 0.0002925
       ============================================================ -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0002925" ixy="0" ixz="0"
               iyy="0.00054"   iyz="0"
               izz="0.0002925"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.165 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="30"/>
  </joint>

  <!-- ============================================================
       右轮（与左轮对称）
       ============================================================ -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0002925" ixy="0" ixz="0"
               iyy="0.00054"   iyz="0"
               izz="0.0002925"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.165 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="30"/>
  </joint>

  <!-- ============================================================
       万向轮（caster）：前后各一个，给车第三个/第四个支撑点
       没有它，两个轮子撑不住车身，车会往前后翻倒
       球 r=0.03，质量 0.1 kg，I = 2*m*r²/5 = 0.000036
       ============================================================ -->
  <link name="caster_front">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.000036" ixy="0" ixz="0"
               iyy="0.000036" iyz="0"
               izz="0.000036"/>
    </inertial>
  </link>

  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front"/>
    <origin xyz="0.15 0 -0.03" rpy="0 0 0"/>
  </joint>

  <link name="caster_rear">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.000036" ixy="0" ixz="0"
               iyy="0.000036" iyz="0"
               izz="0.000036"/>
    </inertial>
  </link>

  <joint name="caster_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rear"/>
    <origin xyz="-0.15 0 -0.03" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       Gazebo 专属设置
       URDF 里的 <material> 只管 RViz2 的显示颜色，
       Gazebo 要另外用 <gazebo reference=...> 指定材质
       ============================================================ -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="left_wheel">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_wheel">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- 万向轮要零摩擦，否则固定球体会在地上"刮"，把车拖住 -->
  <gazebo reference="caster_front">
    <material>Gazebo/Black</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="caster_rear">
    <material>Gazebo/Black</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ============================================================
       差速驱动插件
       - 订阅 /cmd_vel (geometry_msgs/Twist)，驱动左右轮
       - 发布 /odom (nav_msgs/Odometry)
       - 发布 odom -> base_footprint 的 TF
       - publish_wheel_tf：直接把两个轮子的 TF 也发出来
         （Gazebo 里的轮子角度由物理引擎算，不需要 joint_state_publisher）
       轮距 = 0.165 * 2 = 0.33，轮径 = 0.06 * 2 = 0.12
       ============================================================ -->

    <!-- ============================================================
    激光雷达：固定在车顶
    - 圆柱外壳 r=0.035, 长 0.04，质量 0.1 kg
    - 惯性（实心圆柱）：
        Izz（绕轴）      = m*r²/2          = 0.1*0.035²/2   = 6.125e-5
        Ixx = Iyy（径向）= m(3r²+L²)/12    = 0.1*(0.003675+0.0016)/12 = 4.396e-5
    ============================================================ -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="4.396e-05" ixy="0" ixz="0"
               iyy="4.396e-05" iyz="0"
               izz="6.125e-05"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <material>Gazebo/Red</material>

    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>

      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>

      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

    <!-- ============================================================
       相机：装在车头，朝正前方
       - 小方块 0.03³，0.05 kg，I = m(a²+a²)/12 = 7.5e-6
       - 位置 x=+0.22：车身前面是 +0.20，伸出去 2cm
       - 注意：Gazebo 的相机朝 link 的 +X 方向看，而车的 +X 就是前方，
         所以 rpy 全 0 就对了，不需要转 90°
       ============================================================ -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.03"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="7.5e-06" ixy="0" ixz="0"
               iyy="7.5e-06" iyz="0"
               izz="7.5e-06"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.22 0 0.02" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>

    <sensor type="camera" name="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>15</update_rate>

      <camera name="front">
        <!-- 1.047 rad = 60° 水平视角 -->
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
      </camera>

      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>50</update_rate>

      <num_wheel_pairs>1</num_wheel_pairs>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.33</wheel_separation>
      <wheel_diameter>0.12</wheel_diameter>

      <!-- 每个轮子最大扭矩 20 N·m，最大角加速度 1 rad/s² -->
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
    </plugin>
  </gazebo>
</robot>