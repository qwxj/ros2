# colcon 构建产物（可再生成，不要进版本库）
build/
install/
log/

# rosbag / 录制数据（二进制、体积大）
my_topic_bag/
*.bag
*.db3
*.mcap

# rosbag2 录制数据（体积大，只本地保留）
bags/

# tf2 view_frames 生成的图（需要版本化时删掉这两行）
frames_*.gv
frames_*.pdf

# 编辑器/系统垃圾
.vscode-server/
*.swp
.DS_Store

# Python 字节码缓存
__pycache__/
*.pyc
robot_localization_debug.txt

# 本地 IDE 配置（c_cpp_properties 含机器相关绝对路径）
.vscode/c_cpp_properties.json
.vscode/settings.json

# 编译数据库（由 tools/gen_compile_commands.sh 生成，切勿入库）
compile_commands.json
src/compile_commands.json

# 本地笔记，不纳入版本控制
docs/features/12-mini-slam.md
docs/notes/mini-slam-summary.md
